{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KinoraServer/kinora-registry/main/schema/index.schema.json",
  "title": "Kinora registry index",
  "description": "index.json at the top of a registry.",
  "type": "object",
  "required": ["format", "packages"],
  "properties": {
    "format": { "const": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "description", "author", "license", "versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "kind": { "enum": ["module", "theme", "player-skin", "app-skin"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "author": { "type": "string" },
          "license": { "type": "string" },
          "homepage": { "type": "string", "pattern": "^https://" },
          "recommended": { "type": "boolean" },
          "provides": {
            "type": "array",
            "items": { "enum": ["metadata_provider", "track_selection", "event_subscriber"] }
          },
          "permissions": {
            "type": "object",
            "properties": {
              "http": { "type": "array", "items": { "type": "string" } },
              "storage": { "type": "boolean" },
              "activity": { "type": "boolean" }
            }
          },
          "versions": {
            "description": "Newest first.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["version", "size", "published_at", "manifest", "sha256"],
              "properties": {
                "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
                "min_kinora": { "type": "string" },
                "abi": { "type": "integer" },
                "size": { "type": "integer", "minimum": 0 },
                "published_at": { "type": "integer" },
                "manifest": { "type": "string", "pattern": "^packages/[a-z0-9-]+/[0-9.]+/package\\.json$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
